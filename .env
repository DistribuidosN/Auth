# ============================================================
# DB Server — Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a git (agrégalo al .gitignore)
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
# 127.0.0.1 garantiza que SOLO sea accesible desde localhost
SERVER_HOST=127.0.0.1
SERVER_PORT=8081

# ── Base de datos Postgres ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_seguro_aqui
DB_NAME=image_processing_db
DB_SSLMODE=disable

# ── JWT ───────────────────────────────────────────────────────
# JWT_SECRET_KEY: DEBE ser la misma clave que usa tu Auth Server
# para firmar los tokens de usuario. El DB Server solo valida.
JWT_SECRET_KEY=cambia_esto_por_una_clave_segura_minimo_32_chars

# JWT_SERVICE_SECRET: clave para tokens internos entre servicios
# (orquestador → db-server). Distinta a la anterior.
JWT_SERVICE_SECRET=otra_clave_segura_para_tokens_de_servicio_32chars
